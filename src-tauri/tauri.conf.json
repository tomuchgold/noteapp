{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotePP",
  "version": "0.25.0",
  "identifier": "com.notepp.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NotePP",
        "width": 1280,
        "height": 820,
        "minWidth": 420,
        "minHeight": 360,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "name": "Text Document",
        "description": "Plain text and log files - NotePP",
        "role": "Editor",
        "ext": [
          "txt",
          "log",
          "md",
          "markdown",
          "rst"
        ]
      },
      {
        "name": "Config and Data",
        "description": "JSON YAML TOML INI CSV config files - NotePP",
        "role": "Editor",
        "ext": [
          "json",
          "yaml",
          "yml",
          "toml",
          "ini",
          "cfg",
          "conf",
          "properties",
          "csv",
          "tsv",
          "xml",
          "env"
        ]
      },
      {
        "name": "Source Code",
        "description": "Common programming language source files - NotePP",
        "role": "Editor",
        "ext": [
          "js",
          "mjs",
          "cjs",
          "ts",
          "tsx",
          "jsx",
          "py",
          "rb",
          "go",
          "rs",
          "java",
          "kt",
          "kts",
          "c",
          "h",
          "cpp",
          "hpp",
          "cc",
          "cs",
          "swift",
          "m",
          "php",
          "lua",
          "sh",
          "bash",
          "zsh",
          "fish",
          "ps1",
          "bat",
          "cmd",
          "sql",
          "html",
          "htm",
          "css",
          "scss",
          "less",
          "vue",
          "svelte",
          "dart",
          "pl",
          "r",
          "scala",
          "gradle",
          "cmake",
          "mk",
          "makefile",
          "dockerfile"
        ]
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}