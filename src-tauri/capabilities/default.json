{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "NotePP 默认能力：窗口、文件对话框与文件系统访问范围",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "fs:default",
    "opener:default",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    }
  ]
}
